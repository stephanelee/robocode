      "prepared-after-build/tool-setup-and-preparation-before-artifact-finalization"
    ],
    "additionalRawSources": [
      "/etc/os-release",
      "/usr/lib/os-release",
      "/proc/sys/kernel/random/boot_id",
      "optional /etc/lsb-release"
