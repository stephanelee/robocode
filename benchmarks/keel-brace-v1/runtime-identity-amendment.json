  "identityModel": "Qualified observed operational tuple, NOT canonical VM/build revision or immutable attestation",
  "primaryPregameNativeAuthority": "actual same-worker discovered runner .setup_info",
  "requiredNativeClaim": {
    "image": "ubuntu-26.04",
    "version": "20261025.179.1",
    "includedSoftwareURL": "https://github.com/actions/runner-images/blob/ubuntu26/20261025.179/images/ubuntu/Ubuntu2604-Readme.md",
    "imageReleaseURL": "https://github.com/actions/runner-images/releases/tag/ubuntu26%2F20261025.179"
  },
  "requiredSeparateEnvironmentClaim": {
    "ImageOS": "ubuntu26",
    "ImageVersion": "20261026.180.1"
  },
  "requiredClaimSources": {
    "native": [
